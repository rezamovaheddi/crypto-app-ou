generator client {
    provider = "prisma-client.js"
}

datasource db {
    provider = "postgresql"
}



model Watchlisten {
    id String @id @default(uuid())
    coinid String @unique
    symbol String @unique
    name String
    CreatedAt DateTime @default(now())


    @@index([coinid])
}



model PortfolioUser {
    id String @id @default(uuid())
    coinid String
    symbol String
    account Float
    avgBuyPrice Float
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    @@index([coinid])
}



model priceAlert {
    id String @id @default(uuid())
    coinid String
    targetPrice Float
    condition String
    isTrigged Boolean @default(false)
    createdAt DateTime @default(now())
}